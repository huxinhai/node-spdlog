{
  "name": "node-spdlog",
  "version": "0.1.0",
  "description": "Node.js native addon powered by spdlog via node-addon-api.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "build/Release/*.node",
    "artifacts",
    "binding.gyp",
    "src",
    "spdlog"
  ],
  "scripts": {
    "build": "pnpm run build:native && pnpm run build:ts",
    "build:native": "node-gyp rebuild",
    "build:ts": "tsc -p tsconfig.build.json && node scripts/copy-type-declarations.ts",
    "clean": "node scripts/clean.ts",
    "example": "pnpm run build && node examples/example.ts",
    "install": "node-gyp rebuild",
    "build:artifacts": "node scripts/build-artifacts.ts",
    "package:runner": "node scripts/package-runner-artifact.ts",
    "test": "pnpm run typecheck && node --test test/runtime.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "verify:packaged": "node scripts/verify-packaged-artifact.ts",
    "verify:runtime": "node scripts/verify-runtime.ts"
  },
  "keywords": [
    "node-addon-api",
    "napi",
    "native-addon",
    "spdlog",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "gypfile": true,
  "dependencies": {
    "node-addon-api": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "node-gyp": "^12.3.0",
    "typescript": "^5.9.3"
  }
}
