{
  "name": "node-spdlog",
  "version": "0.1.0",
  "description": "Node.js native addon powered by spdlog via node-addon-api.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "build/Release/*.node",
    "artifacts",
    "binding.gyp",
    "src",
    "spdlog"
  ],
  "scripts": {
    "build": "pnpm run build:native && pnpm run build:ts",
    "build:native": "node-gyp rebuild",
    "build:ts": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/type.d.ts', 'dist/type.d.ts')\"",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true }); require('node:fs').rmSync('dist', { recursive: true, force: true }); require('node:fs').rmSync('artifacts', { recursive: true, force: true })\"",
    "example": "pnpm run build && node examples/example.js",
    "install": "node-gyp rebuild",
    "build:artifacts": "node scripts/build-artifacts.mjs",
    "package:runner": "node scripts/package-runner-artifact.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs"
  },
  "keywords": [
    "node-addon-api",
    "napi",
    "native-addon",
    "spdlog",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "gypfile": true,
  "dependencies": {
    "node-addon-api": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "node-gyp": "^12.3.0",
    "typescript": "^5.9.3"
  }
}
